generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  COURIER
  PARTNER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BLOCKED
}

enum CourierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CourierPresenceStatus {
  OFFLINE
  AVAILABLE
  OFFERED
  DELIVERING
  UNAVAILABLE
}

enum DeliveryOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

enum WalletEntryType {
  DELIVERY_CREDIT
  WITHDRAWAL_DEBIT
  BONUS_CREDIT
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  REVERSAL
}

enum DispatchEventType {
  ADMIN_RELEASED
  SEARCH_STARTED
  OFFER_CREATED
  OFFER_DECLINED
  OFFER_EXPIRED
  OFFER_CANCELED
  OFFER_ACCEPTED
  COURIER_PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  WALLET_CREDITED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_STATUS_CHANGED
}

enum RequirementStatus {
  OPEN
  ANSWERED
  RESOLVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  SEARCHING_COURIER
  COURIER_ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CARD
  PIX
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
  CANCELED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole
  status       UserStatus @default(ACTIVE)

  customerProfile CustomerProfile?
  courierProfile  CourierProfile?
  partnerProfile  PartnerProfile?

  addresses Address[]
  orders    Order[] @relation("CustomerOrders")

  partnerLedgerEntries PartnerLedgerEntry[]
  partnerWithdrawals PartnerWithdrawal[]
  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([role])
  @@index([status])
}

model CustomerProfile {
  id             String @id @default(cuid())
  userId         String @unique
  onboardingData Json?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CourierProfile {
  id     String @id @default(cuid())
  userId String @unique

  approvalStatus CourierStatus         @default(PENDING)
  isOnline       Boolean               @default(false)
  presenceStatus CourierPresenceStatus @default(OFFLINE)
  lastHeartbeatAt DateTime?
  availableSince  DateTime?
  lastOfferAt     DateTime?
  currentLatitude  Decimal? @db.Decimal(10, 7)
  currentLongitude Decimal? @db.Decimal(10, 7)
  locationUpdatedAt DateTime?

  document       String? @unique
  cnh            String?
  cnhCategory    String?
  vehicleBrand   String?
  vehicleModel   String?
  vehiclePlate   String?
  vehicleYear    Int?
  onboardingData Json?
  pixKeyType     PixKeyType?
  pixKey         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  deliveries   Order[]              @relation("CourierOrders")
  ledger       CourierLedgerEntry[]
  withdrawals  Withdrawal[]
  requirements CourierRequirement[]
  deliveryOffers  DeliveryOffer[]
  devicePresences CourierDevicePresence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([approvalStatus])
  @@index([isOnline])
}

model CourierRequirement {
  id          String            @id @default(cuid())
  courierId   String
  title       String
  description String
  response    String?
  status      RequirementStatus @default(OPEN)
  requestedAt DateTime          @default(now())
  answeredAt  DateTime?
  resolvedAt  DateTime?

  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, status])
}

model PartnerProfile {
  id             String @id @default(cuid())
  userId         String @unique
  businessName   String
  document       String?
  onboardingData Json?
  approved       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  locationRef String?
  locationConfirmed Boolean @default(false)
  id     String @id @default(cuid())
  userId String

  label        String?
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  postalCode   String
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  imageUrl String?
  active   Boolean @default(true)
  archived Boolean @default(false)
  position Int     @default(0)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

model Product {
  id         String @id @default(cuid())
  categoryId String

  name        String
  description String?
  imageUrl    String?
  price       Decimal @db.Decimal(10, 2)
  active      Boolean @default(true)
  archived    Boolean @default(false)
  stock       Int     @default(0)

  category   Category    @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([active])
}

model Order {
  id         String @id @default(cuid())
  customerId String
  courierId  String?
  addressId  String

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod?

  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  stripePaymentIntentId String? @unique

  routeDistanceKm      Decimal? @db.Decimal(10, 3)
  routeDurationMinutes Int?
  activeOfferId        String?

  // Código de 4 dígitos exibido somente ao cliente e exigido do motoboy
  // para confirmar a entrega. Nullable para compatibilidade com pedidos
  // criados antes desta funcionalidade.
  deliveryPin         String?
  deliveryPinAttempts Int     @default(0)

  customer User            @relation("CustomerOrders", fields: [customerId], references: [id])
  courier  CourierProfile? @relation("CourierOrders", fields: [courierId], references: [id])
  address  Address         @relation(fields: [addressId], references: [id])

  items          OrderItem[]
  courierLedger  CourierLedgerEntry[]
  deliveryOffers DeliveryOffer[]
  dispatchEvents DispatchEvent[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?
  canceledAt  DateTime?

  @@index([customerId])
  @@index([courierId])
  @@index([status])
  @@index([activeOfferId])
  @@index([createdAt])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String

  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  total       Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model DeliveryOffer {
  id        String @id @default(cuid())
  orderId   String
  courierId String

  status    DeliveryOfferStatus @default(PENDING)
  score     Decimal? @db.Decimal(12, 4)
  expiresAt DateTime
  offeredAt DateTime @default(now())
  respondedAt DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?
  expiredAt  DateTime?
  canceledAt DateTime?

  distanceToPickupKm Decimal? @db.Decimal(10, 3)
  metadata Json?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
  @@index([courierId, status])
  @@index([expiresAt, status])
}

model DispatchEvent {
  id        String @id @default(cuid())
  orderId   String
  courierId String?
  offerId   String?

  type      DispatchEventType
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([courierId, createdAt])
}

model CourierLedgerEntry {
  id        String @id @default(cuid())
  courierId String
  orderId   String?

  type           WalletEntryType
  amount         Decimal @db.Decimal(10, 2)
  description    String
  idempotencyKey String  @unique
  availableAt    DateTime @default(now())
  metadata       Json?

  courier CourierProfile @relation(fields: [courierId], references: [id])
  order   Order?         @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())

  @@index([courierId, availableAt])
  @@index([orderId])
  @@index([createdAt])
}

model Withdrawal {
  id        String @id @default(cuid())
  courierId String

  amount Decimal          @db.Decimal(10, 2)
  status WithdrawalStatus @default(PENDING)

  pixKeyType PixKeyType
  pixKey     String

  receiptUrl  String?
  requestedAt DateTime @default(now())
  processedAt DateTime?

  courier CourierProfile @relation(fields: [courierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId])
  @@index([status])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  refreshTokenHash String?  @unique
  deviceId         String?
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  lastSeenAt       DateTime @default(now())
  revokedAt        DateTime?
  revokedReason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  courierPresence CourierDevicePresence?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

model CourierDevicePresence {
  id        String @id @default(cuid())
  courierId String
  sessionId String @unique

  onlineRequested Boolean @default(false)
  lastHeartbeatAt DateTime @default(now())
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  courier CourierProfile @relation(fields: [courierId], references: [id], onDelete: Cascade)
  session AuthSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courierId, lastHeartbeatAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DeliveryPricingConfig {
  pricingRevision Int @default(1)
  id String @id @default("default")

  distributorName      String  @default("Porto Prime Delivery")
  distributorAddress   String?
  distributorLatitude  Decimal? @db.Decimal(10, 7)
  distributorLongitude Decimal? @db.Decimal(10, 7)

  baseFee              Decimal @default(5.50) @db.Decimal(10, 2)
  includedKm           Decimal @default(3.00) @db.Decimal(10, 2)
  pricePerAdditionalKm Decimal @default(2.50) @db.Decimal(10, 2)
  maxDistanceKm        Decimal @default(25.00) @db.Decimal(10, 2)
  minDeliveryFee       Decimal @default(5.50) @db.Decimal(10, 2)
  maxDeliveryFee       Decimal @default(80.00) @db.Decimal(10, 2)
  offerTimeoutSeconds  Int     @default(30)
  heartbeatTimeoutSeconds Int  @default(45)

  platformCommissionPercent Decimal @default(0.00) @db.Decimal(5, 2)
  storeOpen Boolean @default(true)
  storeMessage String @default("Voltaremos em breve. Sua sacola continua salva.")
  regionRules Json?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model PartnerLedgerEntry {
  id String @id @default(cuid())
  userId String
  type WalletEntryType
  amount Decimal @db.Decimal(10, 2)
  description String
  idempotencyKey String @unique
  availableAt DateTime @default(now())
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  @@index([userId, availableAt])
}

model PartnerWithdrawal {
  id String @id @default(cuid())
  userId String
  amount Decimal @db.Decimal(10, 2)
  status WithdrawalStatus @default(PENDING)
  pixKeyType PixKeyType
  pixKey String
  receiptUrl String?
  requestedAt DateTime @default(now())
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([status])
}

model FinancialAudit {
  id String @id @default(cuid())
  actorId String
  actorName String
  accountUserId String
  action String
  amount Decimal @db.Decimal(10, 2)
  reason String
  reference String?
  withdrawalId String?
  createdAt DateTime @default(now())
  @@index([accountUserId, createdAt])
  @@index([withdrawalId])
}
